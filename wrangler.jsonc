{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teller",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "teller.ink", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "CAMPAIGN", "class_name": "CampaignDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CampaignDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teller",
      "database_id": "9f7b6768-dbb5-4336-bad4-16f44e3e360e",
      "migrations_dir": "migrations",
    },
  ],
  // Secrets (wrangler secret put after first deploy; .dev.vars locally):
  //   - DM_KEY — the Warden's key. Sent as `x-teller-key` on DM mutations.
}
